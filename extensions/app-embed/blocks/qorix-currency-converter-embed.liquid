<style>
  [data-currency-converter-root]{
    opacity: 0;
    animation-name: fadeIn;
    animation-duration: 0.01s;
    animation-delay: 1.5s;
    animation-fill-mode: forwards;
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>

{% assign app_data = app.metafields.currency_converter %}
{% assign active_currencies = app_data.currency_general.value.activeCurrencies %}
{% assign iso_currencies = app_data.iso_currencies.value %}
{% assign display_mode = app_data.currency_design.value.displayMode %}
{% assign flag_style = app_data.currency_design.value.flagStyle %}
{% assign show_currency_name_on_hover = app_data.currency_design.value.behavior.showCurrencyNameOnHover %}
{% assign dark_mode_support = app_data.currency_design.value.behavior.darkModeSupport %}
{% assign location_detection = app_data.currency_general.value.locationDetection %}
{% assign price_display_format = app_data.currency_general.value.priceDisplayFormat %}
{% assign restricted_auto_switch = app_data.currency_general.value.restrictedAutoSwitch %}
{% assign fall_back_currency = app_data.currency_general.value.fallBackCurrency %}
{% assign default_currency = app_data.settings_general.value.storeDefaults.currency %}
{% assign app_behavior = app_data.settings_general.value.appBehavior %}
{% assign show_original_price_on_hover = app_data.currency_design.value.behavior.showOriginalPriceOnHover %}
{% assign theme_customisation = app_data.settings_widget.value.themeCustomisation %}
{% assign visibility = app_data.settings_widget.value.visibility %}
{% assign custom_selector = app_data.settings_widget.value.customSelector %}
{% assign horizontal = app_data.settings_widget.value.offsetFromEdge.horizontal %}
{% assign vertical = app_data.settings_widget.value.offsetFromEdge.vertical %}
{% assign position = app_data.settings_widget.value.position %}

{% if app_data.settings_general.value != blank and app_data.settings_widget.value != blank and app_data.currency_general.value != blank and app_data.currency_design.value != blank and app_data.iso_currencies.value != blank %}
<div data-currency-converter-root class="{% if custom_selector != empty %}inject-widget{% else %}floating-widget {{ position }}{% endif %} ">
  <div data-currency-converter-widget>
    {% assign iso_currency = iso_currencies[default_currency] %}
    <div class="currency-widget__button" data-currency-name="{{ iso_currency.name }}" data-currency-code="{{ iso_currency.currencyCode }}">
      <div class="currency-widget__button-content">
        {% if flag_style != "no_flag" %}
          <img src="https://flags.sifatahmed.info/{{ iso_currency.stateCode }}/flag.{% if flag_style == "2d_flag" %}png{% else %}gif{% endif %}" alt="{% if display_mode == "currency_code" %}{{ iso_currency.currencyCode }}{% else %}{{ iso_currency.name }}{% endif %}" width="24" height="16">
        {% endif %}
        <span>
          {% if display_mode == "currency_code" %}
            {{ iso_currency.currencyCode }}
          {% else %}
            {{ iso_currency.name }}
          {% endif %}
        </span>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6 9L12 15L18 9" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="currency-widget__dropdown">
      <ul data-base-currency="{{ default_currency }}" data-base-rate="1" data-display-format="{{ price_display_format }}">
        {% for tcurrency in active_currencies %}
          {% assign iso_currency = iso_currencies[tcurrency] %}
          <li {% if tcurrency == default_currency %}class="active"{% endif %} data-currency="{{ tcurrency }}" data-symbol="{{ iso_currency.symbol }}" data-name="{{ iso_currency.name }}" data-code="{{ iso_currency.currencyCode }}"
            data-rate="1"
          >
            {% if flag_style != "no_flag" %}
              <img src="https://flags.sifatahmed.info/{{ iso_currency.stateCode }}/flag.{% if flag_style == "2d_flag" %}png{% else %}gif{% endif %}" alt="{% if display_mode == "currency_code" %}{{ iso_currency.currencyCode }}{% else %}{{ iso_currency.name }}{% endif %}" width="24" height="16">
            {% endif %}
            <span>
              {% if display_mode == "currency_code" %}
                {{ iso_currency.currencyCode }}
              {% else %}
                {{ iso_currency.name }}
              {% endif %}
            </span>
          </li>
        {% endfor %} 
      </ul>
    </div>
  </div>
</div>

<script>
  window.CurrencyAppConfig = {{ app.metafields.currency_converter | json }};
  document.addEventListener('DOMContentLoaded', () => {
    let widgetInstances = [];

    document.querySelector("body").addEventListener("click", (event) => {
      widgetInstances.forEach((instance) => {
        if (!instance.widget.contains(event.target)) {
          instance.dropdown.classList.remove('active');
          instance.button.classList.remove('active');
        }
      });
    });

    const defaultCurrency = `{{ default_currency }}`.toUpperCase();
    const localStorageKey = `currencyExchangeRates${defaultCurrency}`;
    const exchangeRateApiUrl = `https://v6.exchangerate-api.com/v6/8eeeef10c87f3e890c874cbb/latest/${defaultCurrency}`;
    const exchangeRateFrequency = {{ app_behavior.exchangeRateFrequency | json }};
    const isCurrencyEnabled = {{ app_behavior.enableCurrency | json }};
    const shouldRememberVisitorPreference = {{ app_behavior.enableVisitorPreference | json }};
    const shouldShowWidgetOnAllPages = {{ app_behavior.enableWidgetOnAllPages | json }};
    const shouldDetectLocation = {{ location_detection | json }};
    const shouldShowCurrencyNameOnHover = {{ show_currency_name_on_hover | json }};
    const shouldShowOriginalPriceOnHover = {{ show_original_price_on_hover | json }};
    const restrictedAutoSwitch = {{ restricted_auto_switch | json }};
    const fallbackCurrency = `{{ fall_back_currency }}`.toUpperCase();
    const defaultCurrencySymbol = {{ iso_currencies[default_currency].symbol | json }};
    const defaultCurrencyCode = `{{ iso_currencies[default_currency].currencyCode }}`.toUpperCase();
    const customSelector = {{ custom_selector | json }};
    const floatingPositionClass = `{{ position }}`;
    const selectedCurrencyStorageKey = 'currencyConverterSelectedCurrency';
    const selectedCurrencyVersionStorageKey = 'currencyConverterSelectedCurrencyVersion';
    const visitorPreferenceVersion = {{ app_behavior.visitorPreferenceVersion | default: 1 | json }};
    const geolocationProxyUrl = '/apps/currency-converter/geolocation';
    const exchangeSyncProxyUrl = '/apps/currency-converter/exchange-sync';
    const analyticsProxyUrl = '/apps/currency-converter/analytics';
    const convertedBaseAmountAttribute = 'data-currency-converter-base-amount';
    const priceAmountAttribute = 'data-amount';
    const moneySelector = 'span.money';
    const visitorIdStorageKey = 'currencyConverterVisitorId';
    const widgetViewTrackedStorageKey = 'currencyConverterWidgetViewTracked';
    const exchangeRateFrequencyMap = {
      '6_hours': 6,
      '12_hours': 12,
      '24_hours': 24,
      '48_hours': 48
    };
    const cacheMaxAgeInHours = exchangeRateFrequencyMap[exchangeRateFrequency] || 24;
    let currentSelectionSource = 'default';

    const widgetContainerSelector = '[data-currency-converter-root]';
    const widgetSelector = '[data-currency-converter-widget]';
    const templateWidgetContainer = document.querySelector(widgetContainerSelector);
    const templateWidget = templateWidgetContainer ? templateWidgetContainer.querySelector(widgetSelector) : null;
    const templateCurrencyList = templateWidget ? templateWidget.querySelector('ul[data-base-currency]') : null;
    const templateLists = templateCurrencyList ? templateCurrencyList.querySelectorAll('li[data-currency]') : [];
    const priceDisplayFormat = templateCurrencyList ? templateCurrencyList.getAttribute('data-display-format') : 'with_currency_code';

    if (!templateWidgetContainer || !templateWidget || !templateCurrencyList || !templateLists.length) {
      console.warn('Currency converter widget could not be initialized.');
      return;
    }

    const hideWidget = (container) => {
      container.setAttribute('hidden', 'hidden');
      container.style.display = 'none';
    };

    const showWidget = (container) => {
      container.removeAttribute('hidden');
      container.style.removeProperty('display');
    };

    const getConfiguredCustomSelectors = () => {
      if (typeof customSelector !== 'string') {
        return [];
      }

      return customSelector
        .split(',')
        .map((selector) => selector.trim())
        .filter(Boolean);
    };

    const getCustomSelectorTargets = (selectors) => {
      const targets = [];
      const seenTargets = new Set();

      selectors.forEach((selector) => {
        try {
          document.querySelectorAll(selector).forEach((targetElement) => {
            if (
              !(targetElement instanceof Element) ||
              seenTargets.has(targetElement) ||
              targetElement === templateWidgetContainer ||
              templateWidgetContainer.contains(targetElement)
            ) {
              return;
            }

            seenTargets.add(targetElement);
            targets.push(targetElement);
          });
        } catch (error) {
          console.warn(`Currency converter custom selector is invalid: ${selector}`, error);
        }
      });

      return targets;
    };

    const createWidgetInstance = (container) => {
      const widget = container.querySelector(widgetSelector);
      const button = widget ? widget.querySelector('.currency-widget__button') : null;
      const dropdown = widget ? widget.querySelector('.currency-widget__dropdown') : null;
      const currencyList = dropdown ? dropdown.querySelector('ul[data-base-currency]') : null;
      const lists = currencyList ? Array.from(currencyList.querySelectorAll('li[data-currency]')) : [];

      if (!widget || !button || !dropdown || !currencyList || !lists.length) {
        return null;
      }

      return {
        container,
        widget,
        button,
        dropdown,
        currencyList,
        lists
      };
    };

    const placeWidgets = () => {
      const selectors = getConfiguredCustomSelectors();
      const shouldInjectIntoSelector = selectors.length > 0;

      showWidget(templateWidgetContainer);

      if (!shouldInjectIntoSelector) {
        templateWidgetContainer.className = `floating-widget ${floatingPositionClass}`;
        return [templateWidgetContainer];
      }

      const targetElements = getCustomSelectorTargets(selectors);

      if (!targetElements.length) {
        console.warn(`Currency converter custom selector not found: ${selectors.join(', ')}`);

        if (shouldShowWidgetOnAllPages) {
          templateWidgetContainer.className = `floating-widget ${floatingPositionClass}`;
          return [templateWidgetContainer];
        }

        hideWidget(templateWidgetContainer);
        return [];
      }

      return targetElements.map((targetElement, index) => {
        const container = index === 0 ? templateWidgetContainer : templateWidgetContainer.cloneNode(true);

        container.className = 'inject-widget';
        container.setAttribute('data-currency-converter-instance', String(index + 1));
        showWidget(container);
        targetElement.appendChild(container);

        return container;
      });
    };

    if (!isCurrencyEnabled) {
      hideWidget(templateWidgetContainer);
      return;
    }

    const placedWidgetContainers = placeWidgets();

    if (!placedWidgetContainers.length) {
      return;
    }

    widgetInstances = placedWidgetContainers
      .map((container) => createWidgetInstance(container))
      .filter(Boolean);

    if (!widgetInstances.length) {
      console.warn('Currency converter widget instances could not be initialized.');
      return;
    }

    const readStoredRates = () => {
      try {
        const rawValue = localStorage.getItem(localStorageKey);
        return rawValue ? JSON.parse(rawValue) : null;
      } catch (error) {
        console.error('Error reading exchange rates from storage:', error);
        return null;
      }
    };

    const readStoredCurrencyPreference = () => {
      if (!shouldRememberVisitorPreference) {
        return null;
      }

      try {
        const storedPreferenceVersion = Number.parseInt(localStorage.getItem(selectedCurrencyVersionStorageKey), 10);
        if (storedPreferenceVersion !== visitorPreferenceVersion) {
          clearStoredCurrencyPreference();
          return null;
        }

        const storedCurrency = localStorage.getItem(selectedCurrencyStorageKey);
        return storedCurrency ? storedCurrency.toUpperCase() : null;
      } catch (error) {
        console.error('Error reading stored currency preference:', error);
        return null;
      }
    };

    const getOrCreateVisitorId = () => {
      try {
        const storedVisitorId = sessionStorage.getItem(visitorIdStorageKey);
        if (storedVisitorId) {
          return storedVisitorId;
        }

        const newVisitorId = window.crypto?.randomUUID ? window.crypto.randomUUID() : `visitor-${Date.now()}`;
        sessionStorage.setItem(visitorIdStorageKey, newVisitorId);
        return newVisitorId;
      } catch (_error) {
        return `visitor-${Date.now()}`;
      }
    };

    const trackAnalyticsEvent = async ({ eventType, currencyCode = null, source = null }) => {
      try {
        await fetch(analyticsProxyUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            visitorId: getOrCreateVisitorId(),
            eventType,
            currencyCode,
            source
          })
        });
      } catch (error) {
        console.error('Error tracking analytics event:', error);
      }
    };

    const trackWidgetViewOnce = async () => {
      try {
        const alreadyTracked = sessionStorage.getItem(widgetViewTrackedStorageKey);
        if (alreadyTracked) {
          return;
        }

        sessionStorage.setItem(widgetViewTrackedStorageKey, 'true');
        await trackAnalyticsEvent({ eventType: 'widget_view' });
      } catch (_error) {
        await trackAnalyticsEvent({ eventType: 'widget_view' });
      }
    };

    const storeCurrencyPreference = (currencyCode) => {
      if (!shouldRememberVisitorPreference || !currencyCode) {
        return;
      }

      try {
        localStorage.setItem(selectedCurrencyStorageKey, currencyCode.toUpperCase());
        localStorage.setItem(selectedCurrencyVersionStorageKey, String(visitorPreferenceVersion));
      } catch (error) {
        console.error('Error storing currency preference:', error);
      }
    };

    const clearStoredCurrencyPreference = () => {
      try {
        localStorage.removeItem(selectedCurrencyStorageKey);
        localStorage.removeItem(selectedCurrencyVersionStorageKey);
      } catch (error) {
        console.error('Error clearing stored currency preference:', error);
      }
    };

    const storeExchangeRates = (apiData) => {
      if (!apiData || !apiData.conversion_rates) {
        return null;
      }

      const rateData = {
        conversion_rates: apiData.conversion_rates,
        timestamp: Date.now()
      };

      try {
        localStorage.setItem(localStorageKey, JSON.stringify(rateData));
      } catch (error) {
        console.error('Error storing exchange rates:', error);
      }

      return rateData;
    };

    const notifyExchangeSync = async () => {
      try {
        await fetch(exchangeSyncProxyUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            lastSyncedAt: new Date().toISOString()
          })
        });
      } catch (error) {
        console.error('Error notifying exchange sync:', error);
      }
    };

    const applyRatesToList = (rates) => {
      if (!rates) {
        return;
      }

      widgetInstances.forEach((instance) => {
        instance.lists.forEach((listItem) => {
          const currency = listItem.getAttribute('data-currency');
          const normalizedCurrency = currency ? currency.toUpperCase() : '';

          if (normalizedCurrency && rates[normalizedCurrency]) {
            listItem.setAttribute('data-rate', rates[normalizedCurrency]);
          }
        });
      });
    };

    const getPrimaryWidgetInstance = () => widgetInstances[0] || null;

    const getCurrencyListItem = (currencyCode, instance = getPrimaryWidgetInstance()) => {
      if (!currencyCode || !instance) {
        return null;
      }

      const normalizedCurrencyCode = String(currencyCode).toUpperCase();

      return instance.lists.find((listItem) => {
        const itemCurrency = listItem.getAttribute('data-currency');
        return itemCurrency && itemCurrency.toUpperCase() === normalizedCurrencyCode;
      }) || null;
    };

    const getDefaultCurrencyListItem = (instance = getPrimaryWidgetInstance()) => {
      if (!instance) {
        return null;
      }

      return getCurrencyListItem(defaultCurrency, instance) || instance.dropdown.querySelector('li.active') || instance.lists[0] || null;
    };

    const getFallbackCurrencyListItem = (instance = getPrimaryWidgetInstance()) => {
      return getCurrencyListItem(fallbackCurrency, instance) || getDefaultCurrencyListItem(instance);
    };

    const getRestrictedAutoSwitchCurrencies = () => {
      if (!restrictedAutoSwitch || !restrictedAutoSwitch.isEnabled) {
        return [];
      }

      const restrictedCurrencies = Array.isArray(restrictedAutoSwitch.restrictedCurrencies)
        ? restrictedAutoSwitch.restrictedCurrencies
        : [];

      return restrictedCurrencies.map((currencyCode) => String(currencyCode).toUpperCase());
    };

    const isCurrencyExcludedFromAutoSwitch = (currencyCode) => {
      if (!currencyCode) {
        return true;
      }

      if (!restrictedAutoSwitch || !restrictedAutoSwitch.isEnabled) {
        return false;
      }

      const restrictedCurrencies = getRestrictedAutoSwitchCurrencies();
      return restrictedCurrencies.includes(currencyCode);
    };

    const fetchBrowserIpAddress = async () => {
      try {
        const response = await fetch('/cdn-cgi/trace', {
          method: 'GET',
          headers: {
            Accept: 'text/plain'
          }
        });

        if (!response.ok) {
          throw new Error(`Browser IP lookup failed with status ${response.status}`);
        }

        const traceBody = await response.text();
        const traceLines = traceBody.split('\n');
        const ipLine = traceLines.find((line) => line.startsWith('ip='));

        if (!ipLine) {
          return null;
        }

        const browserIpAddress = ipLine.replace('ip=', '').trim();
        return browserIpAddress || null;
      } catch (error) {
        console.error('Error fetching browser IP address:', error);
        return null;
      }
    };

    const fetchDetectedCurrencyCode = async () => {
      if (!shouldDetectLocation) {
        return null;
      }

      try {
        const browserIpAddress = await fetchBrowserIpAddress();
        const geolocationUrl = new URL(geolocationProxyUrl, window.location.origin);

        if (browserIpAddress) {
          geolocationUrl.searchParams.set('ip', browserIpAddress);
        }

        const response = await fetch(geolocationUrl.toString(), {
          method: 'GET',
          headers: {
            Accept: 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error(`Geolocation request failed with status ${response.status}`);
        }

        const data = await response.json();
        return data?.locationDetection?.currencyCode ? String(data.locationDetection.currencyCode).toUpperCase() : null;
      } catch (error) {
        console.error('Error detecting visitor location:', error);
        return null;
      }
    };

    const getDetectedCurrencyListItem = async () => {
      const detectedCurrencyCode = await fetchDetectedCurrencyCode();

      if (!detectedCurrencyCode) {
        return null;
      }

      if (isCurrencyExcludedFromAutoSwitch(detectedCurrencyCode)) {
        currentSelectionSource = 'fallback';
        return getFallbackCurrencyListItem();
      }

      const detectedCurrencyListItem = getCurrencyListItem(detectedCurrencyCode);

      if (!detectedCurrencyListItem) {
        currentSelectionSource = 'fallback';
        return getFallbackCurrencyListItem();
      }

      currentSelectionSource = 'auto_detect';
      return detectedCurrencyListItem;
    };

    const getInitialCurrencyListItem = async () => {
      const storedCurrency = readStoredCurrencyPreference();
      if (getCurrencyListItem(storedCurrency)) {
        currentSelectionSource = 'restored_preference';
        return getCurrencyListItem(storedCurrency);
      }

      const detectedCurrencyListItem = await getDetectedCurrencyListItem();
      if (detectedCurrencyListItem) {
        return detectedCurrencyListItem;
      }

      currentSelectionSource = 'default';
      return getDefaultCurrencyListItem();
    };

    const fetchExchangeRates = async () => {
      try {
        const response = await fetch(exchangeRateApiUrl);

        if (!response.ok) {
          throw new Error(`Exchange rate request failed with status ${response.status}`);
        }

        const data = await response.json();
        const storedRates = storeExchangeRates(data);

        if (storedRates) {
          applyRatesToList(storedRates.conversion_rates);
          await notifyExchangeSync();
        }
      } catch (error) {
        console.error('Error fetching exchange rates:', error);
      }
    };

    const initializeExchangeRates = async () => {
      const exchangeRates = readStoredRates();

      if (
        exchangeRates &&
        exchangeRates.conversion_rates &&
        exchangeRates.timestamp &&
        exchangeRates.conversion_rates[defaultCurrency]
      ) {
        const hoursDifference = (Date.now() - exchangeRates.timestamp) / (1000 * 60 * 60);

        if (hoursDifference < cacheMaxAgeInHours) {
          applyRatesToList(exchangeRates.conversion_rates);
          return;
        }
      }

      await fetchExchangeRates();
    };

    const formatPrice = (amount, symbol, currencyCode) => {
      const normalizedCurrencyCode = currencyCode ? currencyCode.toUpperCase() : '';

      if (priceDisplayFormat === 'without_currency_code') {
        return `${symbol} ${amount}`;
      }

      if (priceDisplayFormat === 'with_currency_code') {
        return `${symbol} ${amount} ${normalizedCurrencyCode}`.trim();
      }

      return `${amount} ${normalizedCurrencyCode}`.trim();
    };

    const formatOriginalPrice = (amount) => {
      const formattedAmount = amount.toFixed(2);

      if (priceDisplayFormat === 'without_currency_code') {
        return `${defaultCurrencySymbol} ${formattedAmount}`;
      }

      if (priceDisplayFormat === 'with_currency_code') {
        return `${defaultCurrencySymbol} ${formattedAmount} ${defaultCurrencyCode}`.trim();
      }

      return `${formattedAmount} ${defaultCurrencyCode}`.trim();
    };

    const getBaseAmountForPriceElement = (priceElement) => {
      const storedBaseAmountValue = priceElement.getAttribute(convertedBaseAmountAttribute);
      const moneyFormatAmountValue = priceElement.getAttribute(priceAmountAttribute).replace(/[^0-9.\-]+/g, '');
      const storedBaseAmount = Number.parseFloat(storedBaseAmountValue);
      const moneyFormatAmount = Number.parseFloat(moneyFormatAmountValue);

      if (Number.isFinite(moneyFormatAmount)) {
        if (!Number.isFinite(storedBaseAmount) || storedBaseAmount !== moneyFormatAmount) {
          priceElement.setAttribute(convertedBaseAmountAttribute, String(moneyFormatAmount));
        }

        return moneyFormatAmount;
      }

      if (Number.isFinite(storedBaseAmount)) {
        return storedBaseAmount;
      }

      return null;
    };

    const getCurrentSelectedCurrencyListItem = () => {
      const primaryWidgetInstance = getPrimaryWidgetInstance();

      if (!primaryWidgetInstance) {
        return null;
      }

      return primaryWidgetInstance.dropdown.querySelector('li.active') || getDefaultCurrencyListItem(primaryWidgetInstance);
    };

    let currentCurrencySelection = null;
    let priceMutationObserver = null;
    let isPriceMutationObserverActive = false;
    let scheduledPriceRefreshFrame = null;

    const startPriceMutationObserver = () => {
      if (!priceMutationObserver || isPriceMutationObserverActive) {
        return;
      }

      priceMutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
        attributeFilter: [priceAmountAttribute]
      });
      isPriceMutationObserverActive = true;
    };

    const stopPriceMutationObserver = () => {
      if (!priceMutationObserver || !isPriceMutationObserverActive) {
        return;
      }

      priceMutationObserver.disconnect();
      isPriceMutationObserverActive = false;
    };

    const runWithPriceMutationObserverPaused = (callback) => {
      stopPriceMutationObserver();

      try {
        return callback();
      } finally {
        startPriceMutationObserver();
      }
    };

    const refreshOriginalPriceHoverTargets = () => {
      document.querySelectorAll(moneySelector).forEach((priceElement) => {
        if (!shouldShowOriginalPriceOnHover) {
          priceElement.removeAttribute('title');
          return;
        }

        const baseAmount = getBaseAmountForPriceElement(priceElement);

        if (baseAmount === null) {
          priceElement.removeAttribute('title');
          return;
        }

        const originalPriceLabel = `Original price: ${formatOriginalPrice(baseAmount)}`;
        priceElement.setAttribute('title', originalPriceLabel);
      });
    };

    const updateDisplayedPrices = (rate, symbol, currencyCode) => {
      const numericRate = Number.parseFloat(rate);

      if (!Number.isFinite(numericRate)) {
        console.warn('Invalid conversion rate:', rate);
        return;
      }

      runWithPriceMutationObserverPaused(() => {
        document.querySelectorAll(moneySelector).forEach((priceElement) => {
          const baseAmount = getBaseAmountForPriceElement(priceElement);

          if (baseAmount === null) {
            return;
          }

          {% comment %} sifat ........ {% endcomment %}
          const convertedAmount = (baseAmount * numericRate).toFixed(2);
          var priceCalculated = formatPrice(convertedAmount, symbol, currencyCode);
          if(priceCalculated.charAt(0) === '.'){
            priceCalculated = priceCalculated.slice(1);
            priceElement.textContent = priceCalculated;
          }else{
            priceElement.textContent = priceCalculated;
          }

          if (shouldShowOriginalPriceOnHover) {
            const originalPriceLabel = `Original price: ${formatOriginalPrice(baseAmount)}`;
            priceElement.setAttribute('title', originalPriceLabel);
          } else {
            priceElement.removeAttribute('title');
          }
        });
      });
    };

    const findMoneyElementFromNode = (node) => {
      if (!node) {
        return null;
      }

      if (node.nodeType === Node.TEXT_NODE) {
        return node.parentElement ? node.parentElement.closest(moneySelector) : null;
      }

      if (!(node instanceof Element)) {
        return null;
      }

      if (node.matches(moneySelector)) {
        return node;
      }

      return node.closest(moneySelector) || node.querySelector(moneySelector);
    };

    const schedulePriceRefresh = () => {
      if (scheduledPriceRefreshFrame !== null) {
        return;
      }

      scheduledPriceRefreshFrame = window.requestAnimationFrame(() => {
        scheduledPriceRefreshFrame = null;
        reapplyCurrentCurrencySelection();
      });
    };

    const mutationRequiresPriceRefresh = (mutation) => {
      if (mutation.type === 'attributes' || mutation.type === 'characterData') {
        return Boolean(findMoneyElementFromNode(mutation.target));
      }

      if (mutation.type === 'childList') {
        if (findMoneyElementFromNode(mutation.target)) {
          return true;
        }

        return Array.from(mutation.addedNodes).some((node) => Boolean(findMoneyElementFromNode(node)));
      }

      return false;
    };

    const resetDropdownInlinePosition = (dropdown) => {
      dropdown.style.removeProperty('top');
      dropdown.style.removeProperty('right');
      dropdown.style.removeProperty('bottom');
      dropdown.style.removeProperty('left');
      dropdown.style.removeProperty('transform-origin');
    };

    const positionInjectedDropdown = (instance) => {
      if (!instance.container.classList.contains('inject-widget')) {
        return;
      }

      const gap = 4;
      const viewportPadding = 12;
      const dropdown = instance.dropdown;
      const wasActive = dropdown.classList.contains('active');

      resetDropdownInlinePosition(dropdown);

      if (!wasActive) {
        dropdown.style.visibility = 'hidden';
        dropdown.style.pointerEvents = 'none';
        dropdown.classList.add('active');
      }

      const buttonRect = instance.button.getBoundingClientRect();
      const dropdownList = dropdown.querySelector('ul');
      const dropdownHeight =
        dropdown.offsetHeight ||
        dropdownList?.offsetHeight ||
        dropdownList?.clientHeight ||
        Math.min(dropdownList?.scrollHeight || 0, 200);
      const dropdownWidth =
        dropdown.offsetWidth ||
        dropdownList?.offsetWidth ||
        dropdownList?.clientWidth ||
        dropdown.scrollWidth ||
        dropdownList?.scrollWidth ||
        0;
      const spaceBelow = window.innerHeight - buttonRect.bottom;
      const spaceAbove = buttonRect.top;
      const wouldOverflowBottom = buttonRect.bottom + gap + dropdownHeight > window.innerHeight - viewportPadding;
      const shouldOpenUp = wouldOverflowBottom && (spaceAbove >= dropdownHeight + gap || spaceAbove > spaceBelow);
      const wouldOverflowRight = buttonRect.left + dropdownWidth > window.innerWidth - viewportPadding;
      const wouldOverflowLeftWhenRightAligned = buttonRect.right - dropdownWidth < viewportPadding;

      dropdown.style.top = shouldOpenUp ? 'auto' : `calc(100% + ${gap}px)`;
      dropdown.style.bottom = shouldOpenUp ? `calc(100% + ${gap}px)` : 'auto';
      dropdown.style.transformOrigin = shouldOpenUp ? 'bottom' : 'top';
      dropdown.style.left = wouldOverflowRight && !wouldOverflowLeftWhenRightAligned ? 'auto' : '0';
      dropdown.style.right = wouldOverflowRight && !wouldOverflowLeftWhenRightAligned ? '0' : 'auto';

      if (!wasActive) {
        dropdown.classList.remove('active');
        dropdown.style.removeProperty('visibility');
        dropdown.style.removeProperty('pointer-events');
      }
    };

    const applyCurrencySelection = (listItem, options = {}) => {
      if (!listItem) {
        return;
      }

      const { persistPreference = true, source = 'manual', trackEvent = true } = options;

      const selectedCurrencyCode = listItem.getAttribute('data-currency') || '';
      const normalizedCurrencyCode = selectedCurrencyCode.toUpperCase();
      const selectedListItem = getCurrencyListItem(normalizedCurrencyCode) || listItem;
      const rate = selectedListItem.getAttribute('data-rate');
      const img = selectedListItem.querySelector('img');
      const imgSource = img ? img.getAttribute('src') : null;
      const label = selectedListItem.querySelector('span');
      const text = label ? label.textContent : '';
      const dataSymbol = selectedListItem.getAttribute('data-symbol') || '';
      const currencyName = selectedListItem.getAttribute('data-name') || '';

      if (!normalizedCurrencyCode) {
        return;
      }

      widgetInstances.forEach((instance) => {
        const instanceListItem = getCurrencyListItem(normalizedCurrencyCode, instance);
        const displayListItem = instanceListItem || selectedListItem;
        const instanceImg = displayListItem.querySelector('img');
        const instanceImgSource = instanceImg ? instanceImg.getAttribute('src') : imgSource;
        const instanceLabel = displayListItem.querySelector('span');
        const instanceText = instanceLabel ? instanceLabel.textContent : text;
        const instanceCurrencyName = displayListItem.getAttribute('data-name') || currencyName;
        const buttonImage = instance.button.querySelector('img');
        const buttonLabel = instance.button.querySelector('span');

        instance.lists.forEach((item) => {
          item.classList.toggle('active', item === instanceListItem);
        });

        if (instanceImgSource && buttonImage) {
          buttonImage.setAttribute('src', instanceImgSource);
        }

        if (buttonLabel) {
          buttonLabel.textContent = instanceText;
        }

        instance.button.setAttribute('data-currency-name', instanceCurrencyName);
        instance.button.setAttribute('data-currency-code', normalizedCurrencyCode);

        instance.dropdown.classList.remove('active');
        instance.button.classList.remove('active');
      });

      currentCurrencySelection = {
        rate,
        symbol: dataSymbol,
        currencyCode: normalizedCurrencyCode
      };

      updateDisplayedPrices(rate, dataSymbol, normalizedCurrencyCode);

      if (persistPreference && shouldRememberVisitorPreference) {
        storeCurrencyPreference(normalizedCurrencyCode);
      } else if (!shouldRememberVisitorPreference) {
        clearStoredCurrencyPreference();
      }

      if (trackEvent) {
        if (source === 'manual') {
          trackAnalyticsEvent({
            eventType: 'currency_switch_manual',
            currencyCode: normalizedCurrencyCode,
            source
          });
        } else {
          trackAnalyticsEvent({
            eventType: 'currency_switch_auto',
            currencyCode: normalizedCurrencyCode,
            source
          });
        }
      }
    };

    widgetInstances.forEach((instance) => {
      instance.button.addEventListener('click', (event) => {
        event.stopPropagation();
        const shouldOpenDropdown = !instance.dropdown.classList.contains('active');

        widgetInstances.forEach((otherInstance) => {
          otherInstance.dropdown.classList.remove('active');
          otherInstance.button.classList.remove('active');
        });

        if (shouldOpenDropdown) {
          positionInjectedDropdown(instance);
          instance.dropdown.classList.add('active');
          instance.button.classList.add('active');
        }
      });

      instance.lists.forEach((listItem) => {
        listItem.addEventListener('click', function () {
          applyCurrencySelection(this, { persistPreference: true, source: 'manual' });
        });
      });
    });

    const reapplyCurrentCurrencySelection = () => {
      if (!currentCurrencySelection) {
        const currentSelectedCurrencyListItem = getCurrentSelectedCurrencyListItem();

        if (!currentSelectedCurrencyListItem) {
          return;
        }

        currentCurrencySelection = {
          rate: currentSelectedCurrencyListItem.getAttribute('data-rate'),
          symbol: currentSelectedCurrencyListItem.getAttribute('data-symbol') || '',
          currencyCode: currentSelectedCurrencyListItem.getAttribute('data-currency') || ''
        };
      }

      updateDisplayedPrices(
        currentCurrencySelection.rate,
        currentCurrencySelection.symbol,
        currentCurrencySelection.currencyCode
      );
      refreshOriginalPriceHoverTargets();
    };

    priceMutationObserver = new MutationObserver((mutations) => {
      const hasRelevantMoneyMutation = mutations.some((mutation) => mutationRequiresPriceRefresh(mutation));

      if (hasRelevantMoneyMutation) {
        schedulePriceRefresh();
      }
    });

    const initializeWidget = async () => {
      await trackWidgetViewOnce();
      await initializeExchangeRates();
      const initialCurrencyListItem = await getInitialCurrencyListItem();
      applyCurrencySelection(initialCurrencyListItem, { persistPreference: false, source: currentSelectionSource });
      refreshOriginalPriceHoverTargets();
      startPriceMutationObserver();
    };

    initializeWidget();
  });
</script>
<style>
  [data-currency-converter-root] {
    --w-bg: {{ theme_customisation.backgroundColor }};
    --w-border-color: {{ theme_customisation.borderColor }};
    --w-border-radius: {{ theme_customisation.borderRadius }}px;
    --w-text-color: {{ theme_customisation.textColor }};
    --w-hover-color: {{ theme_customisation.hoverColor }};
    --w-bg-hover: {{ theme_customisation.hoverBackground }};
    --w-dark-bg: #181818;
    --w-dark-border-color: #3a3a3a;
    --w-dark-text-color: #f5f5f5;
    --w-dark-hover-color: #ffffff;
    --w-dark-bg-hover: #252525;
    --horizontal: {{ horizontal }}px;
    --vertical: {{ vertical }}px;
  }

  {% if dark_mode_support %}
    @media (prefers-color-scheme: dark) {
      [data-currency-converter-root] {
        --w-bg: var(--w-dark-bg);
        --w-border-color: var(--w-dark-border-color);
        --w-text-color: var(--w-dark-text-color);
        --w-hover-color: var(--w-dark-hover-color);
        --w-bg-hover: var(--w-dark-bg-hover);
      }
    }
  {% endif %}

  {% unless visibility.enableOnDesktop %}
    @media screen and (min-width: 769px) {
      [data-currency-converter-root] {
        display: none !important;
      }
    }
  {% endunless %}

  {% unless visibility.enableOnMobile %}
    @media screen and (max-width: 768px) {
      [data-currency-converter-root] {
        display: none !important;
      }
    }
  {% endunless %}

</style>
{% endif %}

